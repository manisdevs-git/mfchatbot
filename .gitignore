.env
.venv/
venv/
__pycache__/
node_modules/
web/dist/
*.py[cod]
.pytest_cache/
*.egg-info/

# Official downloads (rebuild locally from the manifest)
data/raw/*
!data/raw/.gitkeep

# Chroma is rebuilt from data/processed/embeddings.jsonl
data/index/*
!data/index/.gitkeep
data/index.bak/
data/index.next/

# Ingest staging and failed swap leftovers
data/.ingest-staging/
data/processed.bak/
data/processed.next/

# Local scheduler state (times, run history)
data/scheduler/*
!data/scheduler/.gitkeep
